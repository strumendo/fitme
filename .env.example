# Copy this file to .env and fill in your values. .env is gitignored.

# Garmin Connect credentials. Used only the first time (or if cached tokens expire).
# After a successful login, OAuth tokens are cached at $GARMINTOKENS and re-used.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional. Defaults to ~/.garminconnect.
# GARMINTOKENS=~/.garminconnect

# Optional. One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
# LOG_LEVEL=INFO

# Optional. SQLite DB path. Relative paths resolve against the project root.
# Defaults to data/fitme.db (gitignored). Created on first ingest.
# FITME_DB_PATH=data/fitme.db

# Optional. Anthropic API key for the Coach page (LLM-generated weekly
# program). Without it the rest of the app works; only Coach generation is
# disabled. Create one at https://console.anthropic.com/.
# ANTHROPIC_API_KEY=
